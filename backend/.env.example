HTTP_ADDRESS=:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/21mobile?sslmode=disable
CORS_ALLOWED_ORIGINS=http://localhost:5173
DOCS_ENABLED=true
WHITELABEL_BASE_URL=https://endpoint.devyx.com.br
WHITELABEL_API_TOKEN=
# One authorized Brazilian test destination (DDD + number); empty disables admin test sends.
TEST_SMS_DESTINATION=
MFA_ENCRYPTION_KEY=
RECOVERY_SMTP_HOST=
RECOVERY_SMTP_PORT=
RECOVERY_SMTP_USER=
RECOVERY_SMTP_PASSWORD=
RECOVERY_SMTP_FROM=
PUBLIC_APP_URL=

# Local HTTP only. Production requires true and HTTPS origins.
COOKIE_SECURE=false
COOKIE_CROSS_SITE=false
# Internal normalized DLR ingress. Keep disabled until supplier contract is verified.
CALLBACK_INGRESS_ENABLED=false
CALLBACK_INGRESS_TOKEN=

# Base64 of 32 random bytes; keep outside the database and source control.
PROVIDER_TOKEN_KEY=

# Separate AES-256 key for MO content; keep ingress disabled until provider integration is verified.
MO_CONTENT_KEY=
MO_INGRESS_ENABLED=false

# Operations: never store real keys/tokens in this example file.
MO_RETENTION_DAYS=90
PROVIDER_ACTIVE_KEY_ID=
PROVIDER_ENCRYPTION_KEYS=
MO_ACTIVE_KEY_ID=
MO_ENCRYPTION_KEYS=
MO_FINGERPRINT_KEY=
OPERATIONS_ENABLED=false
OPERATIONS_TOKEN=

# Shared peer-IP budget before API authentication; account failures limited separately.
API_AUTH_IP_LIMIT_PER_MINUTE=600

# Enable only after migration 010 and configuring the private key in the backend process.
SCHEDULER_ENABLED=false
SCHEDULED_CONTENT_KEY=
SMS_HISTORY_CONTENT_KEY=
SMS_HISTORY_ACTIVE_KEY_ID=
SMS_HISTORY_ENCRYPTION_KEYS=
SCHEDULED_ACTIVE_KEY_ID=
SCHEDULED_ENCRYPTION_KEYS=

# Standard SQS queue provisioned separately. IAM via the AWS default role chain.
SCHEDULED_SQS_ENABLED=false
SCHEDULED_SQS_QUEUE_URL=
AWS_REGION=
