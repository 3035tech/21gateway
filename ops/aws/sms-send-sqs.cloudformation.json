{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "21 Mobile HML SMS send-reference queue v2 with DLQ, SQS-managed encryption and TLS-only access.",
  "Parameters": {
    "EnvironmentName": {
      "Type": "String",
      "AllowedPattern": "[a-z][a-z0-9-]{2,30}",
      "Description": "21 Mobile environment name"
    },
    "MaxReceiveCount": {
      "Type": "Number",
      "Default": 100,
      "MinValue": 10,
      "MaxValue": 1000,
      "Description": "Includes normal visibility deferrals; tune with workload tests"
    }
  },
  "Resources": {
    "DispatchDLQ": {
      "Type": "AWS::SQS::Queue",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "QueueName": {
          "Fn::Sub": "${EnvironmentName}-21mobile-sms-send-dlq"
        },
        "SqsManagedSseEnabled": true,
        "MessageRetentionPeriod": 1209600,
        "RedriveAllowPolicy": {
          "redrivePermission": "byQueue",
          "sourceQueueArns": [
            {
              "Fn::Sub": "arn:${AWS::Partition}:sqs:${AWS::Region}:${AWS::AccountId}:${EnvironmentName}-21mobile-sms-send"
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "21mobile"
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "EnvironmentName"
            }
          },
          {
            "Key": "Purpose",
            "Value": "sms-send"
          }
        ]
      }
    },
    "DispatchQueue": {
      "Type": "AWS::SQS::Queue",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "QueueName": {
          "Fn::Sub": "${EnvironmentName}-21mobile-sms-send"
        },
        "SqsManagedSseEnabled": true,
        "MessageRetentionPeriod": 345600,
        "MaximumMessageSize": 1024,
        "ReceiveMessageWaitTimeSeconds": 20,
        "VisibilityTimeout": 90,
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": [
              "DispatchDLQ",
              "Arn"
            ]
          },
          "maxReceiveCount": {
            "Ref": "MaxReceiveCount"
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "21mobile"
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "EnvironmentName"
            }
          },
          {
            "Key": "Purpose",
            "Value": "sms-send"
          }
        ]
      }
    },
    "DLQVisibleAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Dispatch references in DLQ require investigation; connect notification actions separately",
        "Namespace": "AWS/SQS",
        "MetricName": "ApproximateNumberOfMessagesVisible",
        "Dimensions": [
          {
            "Name": "QueueName",
            "Value": {
              "Fn::GetAtt": [
                "DispatchDLQ",
                "QueueName"
              ]
            }
          }
        ],
        "Statistic": "Maximum",
        "Period": 60,
        "EvaluationPeriods": 1,
        "Threshold": 0,
        "ComparisonOperator": "GreaterThanThreshold",
        "TreatMissingData": "notBreaching"
      }
    },
    "TLSOnlyDispatchQueuePolicy": {
      "Type": "AWS::SQS::QueuePolicy",
      "Properties": {
        "Queues": [
          {
            "Ref": "DispatchQueue"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "sqs:*",
              "Resource": {
                "Fn::GetAtt": [
                  "DispatchQueue",
                  "Arn"
                ]
              },
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "TLSOnlyDLQPolicy": {
      "Type": "AWS::SQS::QueuePolicy",
      "Properties": {
        "Queues": [
          {
            "Ref": "DispatchDLQ"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "sqs:*",
              "Resource": {
                "Fn::GetAtt": [
                  "DispatchDLQ",
                  "Arn"
                ]
              },
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "QueueURL": {
      "Value": {
        "Ref": "DispatchQueue"
      }
    },
    "QueueARN": {
      "Value": {
        "Fn::GetAtt": [
          "DispatchQueue",
          "Arn"
        ]
      }
    },
    "DeadLetterQueueURL": {
      "Value": {
        "Ref": "DispatchDLQ"
      }
    },
    "DLQAlarmName": {
      "Value": {
        "Ref": "DLQVisibleAlarm"
      }
    }
  }
}
